#!/usr/bin/env bash

source {{ load_script }}

# quit on errors
set -e
# trace commands
set -x

{%- if update_e3sm_submodule %}
cd {{ polaris_source_dir }}

if [ ! -e e3sm_submodules/E3SM-Project/.git ]; then
    git submodule update --init e3sm_submodules/E3SM-Project
fi

{%- endif %}

{# polaris.provenance reads the source directory from the last cd #}
cd {{ mpas_ocean_subdir }}

git submodule update --init --recursive .

{# polaris.build.source_record reads this record of the source being built #}
{
    echo "source: {{ e3sm_base_dir }}"
    echo "hash: $(git -C {{ e3sm_base_dir }} rev-parse HEAD)"
    echo "describe: $(git -C {{ e3sm_base_dir }} describe --tags --dirty --always)"
    echo "clean_build: {{ 'true' if clean else 'false' }}"
    echo "log:"
    git -C {{ e3sm_base_dir }} log --first-parent -n 5 --format='  %h %s'
} > {{ build_dir }}/mpas_ocean_source.txt

{%- if clean %}
make clean
{%- endif %}

make {{ make_flags }} {{ make_target }}

mkdir -p {{ build_dir }}/default_inputs
mkdir -p {{ build_dir }}/src

cp -r {{ mpas_ocean_subdir }}/default_inputs/namelist.ocean.forward \
    {{ build_dir }}/default_inputs

cp -r {{ mpas_ocean_subdir }}/default_inputs/streams.ocean.forward \
    {{ build_dir }}/default_inputs

cp -r {{ mpas_ocean_subdir }}/src/Registry_processed.xml \
    {{ build_dir }}/src

cp -r {{ mpas_ocean_subdir }}/ocean_model \
    {{ build_dir }}
