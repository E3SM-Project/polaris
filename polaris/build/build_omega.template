#!/usr/bin/env bash

cwd=${PWD}

{{ nersc_host }}
module load cmake
module load python

# quit on errors
set -e
# trace commands
set -x

{%- if update_omega_submodule %}
cd {{ polaris_source_dir }}

if [ ! -e e3sm_submodules/Omega/.git ]; then
    git submodule update --init e3sm_submodules/Omega
fi

{%- endif %}

cd {{ omega_base_dir }}

{# update only when needed: an update rewrites each submodule's config even
   when nothing changes, so concurrent builds of one tree would collide #}
submodules="externals/ekat externals/scorpio components/omega/external cime"
submodule_status=$(git submodule status --recursive -- ${submodules})
if grep -q '^[-+U]' <<< "${submodule_status}"; then
    git submodule update --init --recursive -- ${submodules}
fi

cd ${cwd}

cd {{ build_dir }}

{# polaris.build.source_record reads this record of the source being built #}
if [ -f CMakeCache.txt ]; then
    clean_build=false
else
    clean_build=true
fi
{
    echo "source: {{ omega_base_dir }}"
    echo "hash: $(git -C {{ omega_base_dir }} rev-parse HEAD)"
    echo "describe: $(git -C {{ omega_base_dir }} describe --tags --dirty --always)"
    echo "clean_build: ${clean_build}"
    echo "log:"
    git -C {{ omega_base_dir }} log --first-parent -n 5 --format='  %h %s'
} > omega_source.txt

export METIS_ROOT={{ metis_root }}
export PARMETIS_ROOT={{ parmetis_root }}

cmake \
   -DOMEGA_BUILD_TYPE={{ build_type }} \
   -DOMEGA_CIME_COMPILER={{ compiler }} \
   -DOMEGA_CIME_MACHINE={{ machine }} \
   -DOMEGA_METIS_ROOT=${METIS_ROOT} \
   -DOMEGA_PARMETIS_ROOT=${PARMETIS_ROOT} \
   -DOMEGA_BUILD_TEST=ON \
   -Wno-dev \
   -S {{ omega_base_dir }}/components/omega \
   -B . {{ cmake_flags }}

{{ build_command }}
